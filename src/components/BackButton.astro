---
const { fallbackUrl = "/blog" } = Astro.props;
---

<a
  href={fallbackUrl}
  class="stack-row link"
  data-fallback={fallbackUrl}
  id="back-link"
>
  <div class="back-icon">
    <img src={`/images/back.svg`} alt="retour" />
  </div>
  Retour
</a>

<style>
  .back-icon {
    margin-right: 6px;
    min-width: 14px;
  }
</style>

<script>
  document.getElementById("back-link")?.addEventListener("click", (e) => {
    e.preventDefault();
    const fallback = (e.currentTarget as HTMLAnchorElement).dataset.fallback;

    if (window.history.length > 1) {
      window.history.back();
    } else if (fallback) {
      window.location.href = fallback;
    }
  });
</script>
